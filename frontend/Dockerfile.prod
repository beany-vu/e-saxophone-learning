# Production image. The sibling Dockerfile is the dev one: it skips `next
# build` entirely because compose bind-mounts the source and runs `next dev`.
# This one produces a real optimised build with no source on the final layer.

FROM node:22-alpine AS deps
WORKDIR /app
# Copied on their own so this layer is only rebuilt when the manifest changes.
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
# next.config's rewrites() is evaluated by `next build` and baked into the
# output, so this has to be set here - setting it only at runtime leaves the
# proxy pointing at the compiled-in localhost fallback.
ARG API_INTERNAL_URL=http://api:8080
ENV API_INTERNAL_URL=$API_INTERNAL_URL
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-alpine AS run
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
RUN addgroup -S -g 10001 app && adduser -S -u 10001 -G app app
# `output: 'standalone'` writes a server plus the node_modules it actually
# reaches. Static assets are deliberately left out of it, so copy them too.
COPY --from=build --chown=app:app /app/.next/standalone ./
COPY --from=build --chown=app:app /app/.next/static ./.next/static
USER app
EXPOSE 3000
# wget is in the busybox base image; used by the compose healthcheck.
CMD ["node", "server.js"]
