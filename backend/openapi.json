{
  "openapi": "3.1.0",
  "info": {
    "title": "e-Saxophone practice API",
    "version": "1.0.0",
    "description": "Accounts, practice sessions and course dates for the e-Saxophone practice tracker, made for the Yamaha YDS-120. Authentication is a JWT in an HttpOnly cookie called session, set by signup or login. The browser calls this API through the Next.js dev server at http://localhost:3000/api/*, which proxies to http://api:8080 over the compose network, so a browser client is same-origin and needs no CORS."
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "Through the web app, which is how the browser reaches it" },
    { "url": "http://localhost:8080", "description": "The Go service directly" }
  ],
  "tags": [
    { "name": "health", "description": "Liveness" },
    { "name": "auth", "description": "Accounts and the session cookie" },
    { "name": "practice", "description": "Practice sessions, progress and course dates" },
    { "name": "meta", "description": "This document" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "Liveness check",
        "description": "Answers without touching the database, so it says the process is up rather than that everything works.",
        "responses": {
          "200": {
            "description": "The service is running",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "status": { "type": "string", "const": "ok" } } }
              }
            }
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "tags": ["meta"],
        "summary": "This document",
        "description": "The OpenAPI description of this API. Served without a session so tooling can read it.",
        "responses": { "200": { "description": "The OpenAPI document" } }
      }
    },
    "/api/auth/signup": {
      "post": {
        "tags": ["auth"],
        "summary": "Create an account and log in",
        "description": "Creates the account, then sets the session cookie, so a new user does not have to log in separately. The password is stored as a bcrypt hash and is never returned.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Credentials" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created, session cookie set",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "400": { "description": "Missing or short password, or a malformed body" },
          "409": { "description": "That email already has an account" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Log in and set the session cookie",
        "description": "The cookie is HttpOnly and SameSite=Lax. It is not marked Secure, which is correct over plain HTTP on localhost and must change under HTTPS.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Credentials" } } }
        },
        "responses": {
          "200": {
            "description": "Logged in",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "401": { "description": "Wrong email or password. Both failures answer the same way on purpose" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["auth"],
        "summary": "Clear the session cookie",
        "description": "Expires the cookie. Succeeds whether or not anyone was logged in.",
        "responses": { "200": { "description": "Cookie expired" } }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["auth"],
        "summary": "Who the session belongs to",
        "description": "Also carries this learner's course dates, since the app needs them on every page and this call already happens on every page.",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": {
            "description": "The signed-in user",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "401": { "description": "No session, or a token that does not verify" }
        }
      }
    },
    "/api/practice/sessions": {
      "post": {
        "tags": ["practice"],
        "summary": "Save one practice session",
        "description": "Writes the session and rolls its per-note counts into the lifetime totals in a single transaction, so the two can never disagree. Note keys outside 0 to 127, or counts of zero or less, are ignored rather than rejected: a bad key should not lose the rest of a practice session.",
        "security": [{ "sessionCookie": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionInput" } } }
        },
        "responses": {
          "201": {
            "description": "Saved",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "id": { "type": "string", "format": "uuid" } } }
              }
            }
          },
          "400": { "description": "Malformed body" },
          "401": { "description": "No session" }
        }
      }
    },
    "/api/practice/summary": {
      "get": {
        "tags": ["practice"],
        "summary": "Everything the Progress page needs",
        "description": "Lifetime totals, per-note counts for the coverage heatmap, the last ten sessions, and per-item statistics. Item accuracy is the best single attempt rather than an average, so practising something badly on purpose cannot lower it.",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": {
            "description": "The summary",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Summary" } } }
          },
          "401": { "description": "No session" }
        }
      }
    },
    "/api/practice/course": {
      "put": {
        "tags": ["practice"],
        "summary": "Set when this learner starts and wants to finish",
        "description": "Both dates are per account, so two learners who began on different days are not marched through the same calendar. Send empty strings to clear them. The target date is advisory: the course is twenty weeks of material whatever date is chosen.",
        "security": [{ "sessionCookie": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CourseDates" } } }
        },
        "responses": {
          "200": { "description": "Saved" },
          "400": { "description": "A date that is not yyyy-mm-dd, or a target on or before the start" },
          "401": { "description": "No session" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session",
        "description": "A JWT set by signup or login. HttpOnly, so a browser client sends it automatically and JavaScript cannot read it."
      }
    },
    "schemas": {
      "Credentials": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 8, "description": "At least 8 characters" },
          "displayName": { "type": "string", "description": "Signup only, optional" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "displayName": { "type": "string" },
          "courseStart": { "type": "string", "description": "yyyy-mm-dd, empty until chosen" },
          "courseTargetEnd": { "type": "string", "description": "yyyy-mm-dd, empty until chosen" },
          "courseWeeksDone": {
            "type": "array",
            "items": { "type": "integer" },
            "description": "Week numbers this learner has ticked off, ascending"
          }
        }
      },
      "SessionInput": {
        "type": "object",
        "properties": {
          "source": { "type": "string", "description": "monitor, exercise, warmup or song", "default": "monitor" },
          "item": { "type": "string", "description": "Which warm-up or song, empty for free playing" },
          "durationSeconds": { "type": "integer", "minimum": 0 },
          "notesPlayed": { "type": "integer", "minimum": 0 },
          "correctNotes": { "type": "integer", "minimum": 0 },
          "wrongNotes": { "type": "integer", "minimum": 0 },
          "noteCounts": {
            "type": "object",
            "description": "MIDI note number as a string key, to how many times it was played",
            "additionalProperties": { "type": "integer" }
          }
        }
      },
      "SessionBrief": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "source": { "type": "string" },
          "durationSeconds": { "type": "integer" },
          "notesPlayed": { "type": "integer" },
          "startedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ItemStat": {
        "type": "object",
        "properties": {
          "item": { "type": "string" },
          "source": { "type": "string" },
          "timesPlayed": { "type": "integer" },
          "bestAccuracy": { "type": "integer", "description": "Percent, from the best single attempt" },
          "totalSeconds": { "type": "integer" },
          "lastPlayedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Summary": {
        "type": "object",
        "properties": {
          "totalSessions": { "type": "integer" },
          "totalNotes": { "type": "integer" },
          "totalSeconds": { "type": "integer" },
          "noteCounts": { "type": "object", "additionalProperties": { "type": "integer" } },
          "recentSessions": { "type": "array", "items": { "$ref": "#/components/schemas/SessionBrief" } },
          "itemStats": { "type": "array", "items": { "$ref": "#/components/schemas/ItemStat" } }
        }
      },
      "CourseDates": {
        "type": "object",
        "properties": {
          "startDate": { "type": "string", "description": "yyyy-mm-dd, or empty to clear" },
          "targetEnd": { "type": "string", "description": "yyyy-mm-dd, or empty to clear" },
          "weeksDone": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1, "maximum": 20 },
            "description": "Weeks ticked off. Omit to leave them alone; send a shorter list to untick. Numbers outside the course, and duplicates, are dropped rather than rejected"
          }
        }
      }
    }
  }
}
