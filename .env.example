# Copy to .env and adjust. docker-compose reads these.

# Postgres
POSTGRES_USER=yds
POSTGRES_PASSWORD=yds_dev_pw
POSTGRES_DB=yds120

# API
# JWT signing secret. Generate a real one for anything beyond local dev:
#   openssl rand -base64 48
JWT_SECRET=dev-secret-change-me

# The account the MCP server reads, so an AI assistant can see your practice.
# Only needed if you connect one; the app itself ignores these.
YDS_EMAIL=you@example.com
YDS_PASSWORD=your-password

# --- production only (docker-compose.prod.yml) ---
# In CI these come from repository secrets, not this file. Needed only if you
# bring the production stack up by hand on the box. See "Deployment" in README.
#
# Token for the Cloudflare tunnel, from Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=
# Public origin of the web app, allowlisted for direct calls to the API host.
WEB_PUBLIC_URL=https://e-saxophone.body-and-binary.net

# The account that gets the admin flag, so it can manage other accounts from
# the Users page. Applied when the API starts if that account already exists,
# and at signup if it does not yet. Leave empty for no admin at all.
# In production this comes from the ADMIN_EMAIL repository secret instead.
ADMIN_EMAIL=
